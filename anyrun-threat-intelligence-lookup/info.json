{
  "name": "anyrun-threat-intelligence-lookup",
  "version": "1.1.0",
  "label": "ANY.RUN Threat Intelligence Lookup",
  "description": "ANY.RUN empowers SOC teams to cut MTTD/MTTR with fast IOC enrichment using the Threat Intelligence Lookup. With the ANY.RUN Threat Intelligence Lookup connector for FortiSOAR, your team achieves: \n- Confident response: Query IOCs/IOAs/IOBs for full context based on live attack data from 15K+ SOCs. Accelerate incient mitigation with actionable intel and reduce MTTR by up to 21 minutes. Use obtained data for incident response, to create new rules, train models, update playbooks, etc.",
  "publisher": "Fortinet",
  "contributor": "ANY.RUN",
  "cs_approved": false,
  "cs_compatible": true,
  "category": [
    "Data Enrichment & Threat Intelligence"
  ],
  "help_online": "",
  "icon_small_name": "small.png",
  "icon_large_name": "large.png",
  "configuration": {
    "fields": [
      {
        "title": "API Key",
        "description": "Specify the API key used to authenticate with the ANY.RUN Threat Intelligence Lookup API. The format of the API Key must be: NS9sY..FwvfR.",
        "type": "password",
        "name": "api_key",
        "required": true,
        "visible": true,
        "editable": true,
        "tooltip": "Specify the API key used to authenticate with the ANY.RUN Threat Intelligence Lookup API. The format of the API Key must be: NS9sY..FwvfR."
      },
      {
        "title": "Verify SSL",
        "description": "Specifies whether the SSL certificate for the server is to be verified. By default, this option is set to True.",
        "type": "checkbox",
        "name": "verify_ssl",
        "required": false,
        "visible": true,
        "editable": true,
        "value": true,
        "tooltip": "Specifies whether the SSL certificate for the server is to be verified. By default, this option is set to True."
      }
    ]
  },
  "operations": [
    {
      "operation": "get_intelligence",
      "title": "Lookup IOC in Threat Intelligence",
      "description": "Retrieves threat intelligence for a specified IOC. This operation requires an ANY.RUN TI Lookup Premium license. For information about supported parameters, see the ANY.RUN Sandbox API documentation.",
      "category": "investigation",
      "annotation": "get_intelligence",
      "enabled": true,
      "parameters": [
        {
          "title": "Query",
          "description": "Specifies the IOC query and any required filters. Supports the logical operators AND, OR, and NOT, as well as parentheses () for grouping conditions.",
          "type": "text",
          "name": "query",
          "required": true,
          "visible": true,
          "editable": true,
          "tooltip": "Specifies the IOC query and any required filters. Supports the logical operators AND, OR, and NOT, as well as parentheses () for grouping conditions."
        },
        {
          "title": "Lookup Depth",
          "description": "(Optional) Specify the number of days, from the current date, to include in the search.",
          "type": "text",
          "name": "lookup_depth",
          "required": false,
          "visible": true,
          "editable": true,
          "value": "180",
          "tooltip": "Specify the number of days, from the current date, to include in the search."
        }
      ],
